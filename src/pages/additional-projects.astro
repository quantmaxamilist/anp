---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import Pill from '../components/site/Pill.astro';
import NextTeaser from '../components/site/NextTeaser.astro';
import TenderBand from '../components/site/TenderBand.astro';
import ProjectCard from '../components/site/ProjectCard.astro';
import { company, home, clients, projects } from '../data/site';
import { pad, excerpt, slug } from '../components/work/util';

const hero = projects[1].image!; // New Cobham House
// Verbatim sentence from the homepage "About" copy.
const lead = home.about[0].split('. ').find((s) => s.includes('track record'))!;
const filters = [
  { key: 'all', label: 'All', n: projects.length },
  ...clients.map((c) => ({ key: slug(c.name), label: c.name, n: c.projects.length })),
];
const dover = projects.find((p) => p.name === '31 Dover Street')!;
---
<Base title="Additional Projects" description={excerpt(lead)} preloadImage={hero.md ?? hero.src}>
  <PageHero
    lines={['Additional', 'Projects']}
    num={pad(projects.length)}
    eyebrow="Projects"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Additional Projects' }]}
    lead={lead}
    image={hero}
    position="50% 55%"
    size="xl"
    em={7.1}
  >
    <Pill href="/contact">Send a tender</Pill>
    <Pill href={company.phoneHref} variant="ghost">{company.phone}</Pill>
  </PageHero>

  <section class="ap on-light" id="projects" data-header-theme="light" data-cursor-theme="light" data-hold-header aria-labelledby="ap-h" data-ap>
    <h2 class="sr-only" id="ap-h">Projects</h2>
    <div class="ap__bar-wrap">
      <div class="container">
        <div class="ap__bar" data-reveal="fade">
          <div class="ap__chips" role="group" aria-label="Filter projects by client">
            {filters.map((f, i) => (
              <button type="button" class="ap__chip mono" data-ap-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'} data-cursor="link">
                <span>{f.label}</span><span class="ap__chip-n">{pad(f.n)}</span>
              </button>
            ))}
          </div>
          <p class="ap__status mono" aria-live="polite" aria-atomic="true" data-ap-status>{projects.length} projects</p>
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="ap__grid" role="list" data-gallery data-ap-grid>
        {projects.map((p, i) => (
          <li class="ap__cell" data-ap-client={p.client ? slug(p.client) : ''} data-c3={i % 3} data-c2={i % 2}>
            <ProjectCard project={p} index={i} total={projects.length} mode="gallery" theme="light" ratio="4 / 5"
              reveal={false} sizes="(min-width: 1024px) 30vw, (min-width: 560px) 46vw, 92vw" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NextTeaser href="/clients" title="Clients" label="Next" num={`${pad(clients.length)} clients`} image={dover.image} />

  <TenderBand />
</Base>

<script>import '../scripts/gallery.js';</script>
<script>import '../scripts/work.js';</script>

<style>
  .ap { position: relative; background: var(--concrete-50); color: var(--navy-700); padding-bottom: var(--section-y); }

  /* Sticky filter dock under the header (the header is held visible over this section: data-hold-header) */
  .ap__bar-wrap { position: sticky; top: calc(var(--header-h) + var(--space-3)); z-index: var(--z-raised); padding-top: var(--space-fluid-m); }
  .ap__bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: 8px; border-radius: var(--radius-pill);
    background: rgb(14 22 48 / 0.92); color: var(--white);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px -24px rgb(14 22 48 / 0.6);
  }
  .ap__chips { display: flex; gap: 6px; min-width: 0; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; border-radius: var(--radius-pill); }
  .ap__chips::-webkit-scrollbar { display: none; }
  .ap__chip {
    flex: none; display: inline-flex; align-items: center; gap: 0.7em; height: 44px; padding: 0 18px; border-radius: var(--radius-pill);
    color: var(--white); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    transition: background var(--dur-fast) var(--ease-out-soft), color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .ap__chip-n { color: var(--mint-500); transition: color var(--dur-fast); }
  .ap__chip:hover { box-shadow: inset 0 0 0 1px var(--mint-500); }
  .ap__chip[aria-pressed='true'] { background: var(--mint-500); color: var(--navy-700); box-shadow: none; }
  .ap__chip[aria-pressed='true'] .ap__chip-n { color: var(--navy-700); }
  .ap__status { flex: none; padding-right: var(--space-4); color: var(--navy-200); }

  /* Grid: 3 / 2 / 1 columns; the middle column sits lower (static `translate`) and drifts with scroll
     (work.js writes `transform` on those cells only, so the grid is never restyled per frame) */
  .ap__grid {
    --ap-off: 0px;
    list-style: none; margin: 0; padding: var(--space-fluid-l) 0 0;
    display: grid; grid-template-columns: 1fr; gap: var(--space-fluid-m) var(--grid-gap);
  }
  .ap__cell { min-width: 0; }
  @media (max-width: 559px) { .ap__cell :global(.pc__frame) { aspect-ratio: 4 / 3; } }
  @media (min-width: 560px) {
    .ap__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); --ap-off: clamp(2.5rem, 6vw, 5rem); padding-bottom: calc(var(--ap-off) + 2rem); }
    .ap__cell[data-c2='1'] { translate: 0 var(--ap-off); }
  }
  @media (min-width: 1024px) {
    .ap__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); --ap-off: clamp(4rem, 7vw, 8rem); }
    .ap__cell[data-c2='1'] { translate: none; }
    .ap__cell[data-c3='1'] { translate: 0 var(--ap-off); }
  }
  :global(html.js:not(.rm)) .ap__cell:not(.is-in) { opacity: 0; }

  @media (max-width: 639px) {
    .ap__bar { padding: 6px; }
    .ap__chip { height: 40px; padding: 0 14px; }
    .ap__status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
</style>
