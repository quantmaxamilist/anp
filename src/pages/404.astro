---
// 404: navy-950 full-viewport "setting-out sheet". The ANP mark draws itself in with one member missing
// (the crossbar, dashed like a setting-out line) and the mono 404 called off it. Neutral UI words only.
import Base from '../layouts/Base.astro';
import Mark from '../components/site/Mark.astro';
import Pill from '../components/site/Pill.astro';
import { company } from '../data/site';
const lines = ['Page', 'not found'];
---
<Base title="Page not found" description="Page not found." noindex page="404">
  <section class="nf" data-header-theme="dark" aria-labelledby="nf-h">
    <div class="nf__grid" aria-hidden="true"></div>
    <div class="container nf__in">
      <div class="nf__art" aria-hidden="true">
        <div class="nf__fig">
          <Mark class="nf__mark" data-reveal="draw" data-delay="0.15" />
          <svg class="nf__call" viewBox="540 540 545 375" focusable="false">
            <path class="nf__lead" d="M689.5 742 L689.5 958" pathLength="1" />
            <path class="nf__tick" d="M647 704 L647 750 M732 704 L732 750" />
          </svg>
          <span class="nf__code mono"><b>404</b></span>
        </div>
      </div>
      <div class="nf__copy">
        <p class="mono tag nf__tag" data-reveal="fade"><b>[ 404 ]</b> {company.address.locality} {company.address.postcode}</p>
        <h1 class="nf__h display" id="nf-h" data-reveal="lines" data-delay="0.1" aria-label="Page not found">
          {lines.map((l) => <span class="line" aria-hidden="true"><span>{l}</span></span>)}
        </h1>
        <nav class="nf__go" aria-label="Useful links" data-reveal="fade" data-delay="0.3">
          <Pill href="/">Home</Pill>
          <Pill href="/services" variant="ghost">What We Do</Pill>
          <Pill href="/contact" variant="ghost">Contact Us</Pill>
        </nav>
        <p data-reveal="fade" data-delay="0.4"><a class="nf__tel" href={company.phoneHref} data-cursor="link"><span class="mono nf__tel-k">Phone</span><span class="display nf__tel-n">{company.phone}</span></a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative; isolation: isolate; overflow: clip;
    min-height: 100svh; display: grid; align-items: center;
    padding-top: calc(var(--header-h) + var(--space-fluid-m)); padding-bottom: var(--space-fluid-l);
    background: var(--navy-950); color: var(--white);
  }
  /* setting-out grid, faded at the edges */
  .nf__grid {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: clamp(48px, 6vw, 96px) clamp(48px, 6vw, 96px);
    background-position: center center;
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 62% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 70% at 62% 45%, #000 20%, transparent 75%);
  }
  .nf__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-7) var(--grid-gap); align-items: center; }
  .nf__copy { grid-column: 1 / 7; grid-row: 1; display: grid; gap: var(--space-6); align-content: center; position: relative; z-index: 1; }
  .nf__art { grid-column: 6 / -1; grid-row: 1; justify-self: end; width: 100%; max-width: 820px; }
  .nf__fig { position: relative; width: 100%; aspect-ratio: 545 / 375; }
  .nf__fig :global(.nf__mark), .nf__call { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .nf__fig :global(.nf__mark path) { stroke-width: 12; }
  /* the missing member: a dashed setting-out line where the crossbar should be */
  .nf__fig :global(.nf__mark path:nth-child(5)) {
    stroke: var(--navy-300); stroke-width: 4; stroke-linecap: butt;
    stroke-dasharray: 0.06 0.045 !important;
    animation: nf-in 0.5s var(--ease-out) 1.3s both, nf-march 1.6s linear 1.3s infinite;
  }
  @keyframes nf-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes nf-march { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -0.21; } }
  .nf__lead { fill: none; stroke: var(--mint-500); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .nf__tick { fill: none; stroke: var(--navy-300); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  :global(html.js:not(.rm)) .nf__lead { stroke-dashoffset: 1; animation: nf-draw 0.7s var(--ease-out) 1.5s forwards; }
  :global(html.js:not(.rm)) .nf__tick, :global(html.js:not(.rm)) .nf__code { opacity: 0; animation: nf-in 0.5s var(--ease-out) 1.7s forwards; }
  @keyframes nf-draw { to { stroke-dashoffset: 0; } }
  .nf__code {
    position: absolute; left: 27.4%; top: 112%; translate: -50% 0;
    padding: 6px 12px; border-radius: var(--radius-pill); background: var(--mint-500); color: var(--navy-950);
    white-space: nowrap;
  }
  .nf__code b { font-weight: 600; }
  .nf__tag { color: var(--navy-300); }
  .nf__h {
    --em: 7.6;
    font-size: min(var(--fs-display-2), calc((min(100vw, var(--container-max)) - 2 * var(--gutter)) * 0.5 / var(--em)));
  }
  .nf__go { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .nf__tel { display: inline-grid; gap: 2px; min-height: 44px; align-content: center; }
  .nf__tel-k { color: var(--navy-300); }
  .nf__tel-n { font-stretch: 100%; font-size: var(--fs-h3); line-height: 1; transition: color var(--dur-fast); }
  .nf__tel:hover .nf__tel-n { color: var(--mint-500); }

  @media (max-width: 1023px) {
    .nf { align-items: start; }
    .nf__copy, .nf__art { grid-column: 1 / -1; }
    .nf__art { grid-row: 1; justify-self: center; max-width: min(560px, 82vw); margin-bottom: var(--space-7); }
    .nf__copy { grid-row: 2; }
    .nf__h { font-size: min(var(--fs-display-2), calc((100vw - 2 * var(--gutter)) / (var(--em) * 0.82))); }
  }
  @media (max-width: 639px) {
    .nf__h { font-size: calc((100vw - 2 * var(--gutter)) / 7.4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf__fig :global(.nf__mark path:nth-child(5)) { animation: none; }
  }
</style>
