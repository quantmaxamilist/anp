---
// Team portrait frame. Blank until the client supplies photos (owner decision 5): a 4:5 concrete frame with a
// hairline, setting-out corner ticks and a faint outlined ANP mark. No initials, no placeholder faces, no text.
// When `photo` is set it renders the photo instead (future-proof; alt = the person's name).
import Mark from '../site/Mark.astro';
interface Props { photo?: string; alt: string }
const { photo, alt } = Astro.props;
---
<div class:list={['pf', photo && 'pf--photo']}>
  {photo ? (
    <img class="pf__img grade" src={photo} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <div class="pf__blank" aria-hidden="true">
      <i class="pf__tick pf__tick--tl"></i><i class="pf__tick pf__tick--tr"></i>
      <i class="pf__tick pf__tick--bl"></i><i class="pf__tick pf__tick--br"></i>
      <Mark class="pf__mark" />
      <Mark class="pf__mark pf__mark--hi" />
    </div>
  )}
</div>

<style>
  .pf {
    position: relative; aspect-ratio: 4 / 5; overflow: clip; border-radius: var(--radius-m);
    background: var(--concrete-200); box-shadow: inset 0 0 0 1px var(--line-on-light);
  }
  .pf__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .pf__blank { position: absolute; inset: 0; }
  .pf__tick { position: absolute; width: 14px; height: 14px; border-color: rgb(35 52 103 / 0.32); border-style: solid; border-width: 0; }
  .pf__tick--tl { left: 12px; top: 12px; border-left-width: 1.5px; border-top-width: 1.5px; }
  .pf__tick--tr { right: 12px; top: 12px; border-right-width: 1.5px; border-top-width: 1.5px; }
  .pf__tick--bl { left: 12px; bottom: 12px; border-left-width: 1.5px; border-bottom-width: 1.5px; }
  .pf__tick--br { right: 12px; bottom: 12px; border-right-width: 1.5px; border-bottom-width: 1.5px; }
  .pf :global(.pf__mark) {
    position: absolute; left: 50%; top: 62%; width: 58%; height: auto; overflow: visible;
    transform: translate(-50%, -50%);
  }
  .pf :global(.pf__mark) { opacity: 0.11; }
  .pf :global(.pf__mark path) { stroke: var(--navy-700); stroke-width: 9; }
  .pf :global(.pf__mark--hi) { opacity: 1; }
  .pf :global(.pf__mark--hi path) {
    stroke: var(--mint-600); stroke-dasharray: 1; stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s var(--ease-out);
  }
  .pf :global(.pf__mark--hi path:nth-child(2)) { transition-delay: 80ms; }
  .pf :global(.pf__mark--hi path:nth-child(3)) { transition-delay: 160ms; }
  .pf :global(.pf__mark--hi path:nth-child(4)) { transition-delay: 240ms; }
  .pf :global(.pf__mark--hi path:nth-child(5)) { transition-delay: 320ms; }
  @media (hover: hover) and (pointer: fine) {
    :global(.tm-card:hover) .pf :global(.pf__mark--hi path) { stroke-dashoffset: 0; }
  }
</style>
