---
// The three testimonials as a quiet stacked list (navy-900): mono index, mint open-quote, the quote in mixed-case
// display with a word-by-word scrubbed reveal (work.js), name + role. Verbatim; no companies.
import SectionHead from '../site/SectionHead.astro';
import { home, testimonials } from '../../data/site';
import { pad } from './util';
const total = testimonials.length;
---
<section class="cl-q" data-header-theme="dark" aria-labelledby="cl-q-h">
  <div class="container">
    <SectionHead title={['Trusted by', 'Our Clients']} label="Testimonials" num={total} id="cl-q-h" size="l" em={7.4} />
    <ol class="cl-q__list" role="list">
      {testimonials.map((t, i) => (
        <li class="cl-q__item">
          <figure class="cl-q__fig">
            <div class="cl-q__side" data-reveal="fade">
              <span class="mono cl-q__i">{pad(i + 1)} / {pad(total)}</span>
              <span class="cl-q__glyph display" aria-hidden="true">“</span>
            </div>
            <blockquote class="cl-q__quote">
              <p><span class="sr-only">{t.quote}</span><span class="cl-q__words" aria-hidden="true" data-cl-words>{t.quote}</span></p>
            </blockquote>
            <figcaption class="cl-q__by" data-reveal="fade" data-delay="0.1">
              <span class="cl-q__name">{t.name}</span>
              <span class="mono cl-q__role">{t.role}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cl-q { background: var(--navy-900); color: var(--white); padding-block: var(--section-y); }
  .cl-q__list { display: grid; }
  .cl-q__item { border-top: 1px solid var(--line-on-dark); }
  .cl-q__item:last-child { border-bottom: 1px solid var(--line-on-dark); }
  .cl-q__fig {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); row-gap: var(--space-5);
    padding-block: var(--space-fluid-m);
  }
  .cl-q__side { grid-column: 1 / 3; display: grid; align-content: start; gap: var(--space-3); }
  .cl-q__i { color: var(--navy-300); }
  .cl-q__glyph { font-size: clamp(4.5rem, 2rem + 7vw, 9rem); line-height: 0.7; color: var(--mint-500); font-stretch: 100%; height: 0.5em; }
  .cl-q__quote { grid-column: 3 / 12; }
  .cl-q__quote p {
    font-family: var(--font-display); font-weight: 600; font-stretch: var(--wdth-text-display);
    font-size: clamp(1.375rem, 0.95rem + 1.7vw, 2.75rem); line-height: var(--lh-statement); letter-spacing: -0.01em;
    max-width: 34ch; text-wrap: pretty;
  }
  .cl-q__words :global(.w) { opacity: var(--o, 1); transition: opacity 0.2s linear; }
  .cl-q__by { grid-column: 3 / 12; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); }
  .cl-q__name { font-weight: var(--wght-text-strong); font-size: var(--fs-lead); }
  .cl-q__role { color: var(--mint-500); }
  @media (max-width: 899px) {
    .cl-q__side { grid-column: 1 / -1; grid-template-columns: auto 1fr; align-items: start; }
    .cl-q__glyph { order: -1; height: 0.45em; }
    .cl-q__i { padding-top: 0.4em; justify-self: end; }
    .cl-q__quote, .cl-q__by { grid-column: 1 / -1; }
  }
</style>
