---
import { home, services } from '../../data/site';
import { zones } from '../../data/extra';
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const trades = services.map((s, i) => {
  const cover = s.images[s.cover];
  // zero-width space after '/' lets 'Alterations/Demolition' break on narrow screens
  return { ...s, i, num: n2(i), cover, zone: zones[s.slug], label: s.name.replace('/', '/\u200B') };
});
// The sticky photo is ~40vw wide on desktop, so the -sm/-md variants are plenty
const srcset = (im: { src: string; sm: string; md?: string; w: number }) =>
  im.md ? `${im.sm} 720w, ${im.md} 1200w` : `${im.sm} 720w, ${im.src} ${im.w}w`;
const headLines = ['Quality', 'Construction.', 'Trusted', 'Results.'];
const words = home.intro.split(' ');
---
<div class="trades" id="trades">
  <section class="tintro" data-header-theme="dark" aria-labelledby="tintro-h" data-tintro>
    <div class="tintro__in container">
      <p class="mono tag" data-reveal="fade"><b>[ {String(services.length).padStart(2, '0')} ]</b> Trade packages</p>
      <h2 class="tintro__h display" id="tintro-h" data-reveal="lines" aria-label={home.servicesHeading}>
        {headLines.map((l) => <span class="line" aria-hidden="true"><span>{l}</span></span>)}
      </h2>
      <div class="datum tintro__datum" data-reveal="datum"></div>
      <p class="tintro__p" aria-label={home.intro} data-words>
        {words.map((w) => <span aria-hidden="true">{w} </span>)}
      </p>
    </div>
  </section>

  <!-- Trade index: a plain list that scrolls normally. On desktop a sticky panel beside it shows the
       photo, quote and actions for the row in the middle of the screen (or under the pointer). Rows never
       change size, so nothing on the page moves when the active trade changes. No pinning. -->
  <section class="tx on-light" data-header-theme="light" data-cursor-theme="light" aria-labelledby="tx-h" data-trades>
    <div class="tx__in container">
      <div class="tx__list">
        <h2 class="sr-only" id="tx-h">Our trade packages</h2>
        <ol class="tx__rows" role="list">
          {trades.map((t) => (
            <li class:list={['tx__row', { 'is-on': t.i === 0 }]} data-tx-row={t.i}>
              <img class="grade tx__thumb" src={t.cover.sm} width={t.cover.w} height={t.cover.h} alt="" loading="lazy" decoding="async" />
              <div class="tx__body">
                <p class="mono tx__tag"><span class="tx__n">{t.num}</span> {t.zone.tag}</p>
                <h3 class="tx__name display"><a href={`/services/${t.slug}`} data-cursor="link">{t.label}<span class="tx__arr" aria-hidden="true">→</span></a></h3>
                <div class="tx__more">
                  <p class="tx__quote">{t.zone.quote}</p>
                  <div class="tx__actions">
                    <button type="button" class="chip" data-add={t.slug} aria-pressed="false"><span class="chip__plus" aria-hidden="true"></span><span class="add-l">Add to tender</span></button>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="tx__media">
        <div class="tx__sticky">
          <div class="tx__frame" aria-hidden="true">
            {trades.map((t) => (
              <img
                class:list={['grade tx__img', { 'is-on': t.i === 0 }]}
                data-tx-img={t.i}
                src={t.cover.md || t.cover.sm}
                srcset={srcset(t.cover)}
                sizes="(min-width: 900px) 40vw, 1px"
                width={t.cover.w}
                height={t.cover.h}
                alt=""
                loading={t.i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
            <span class="tx__big display" data-tx-num>01</span>
          </div>
          <div class="tx__infos">
            {trades.map((t) => (
              <div class:list={['tx__info', { 'is-on': t.i === 0 }]} data-tx-info={t.i} inert={t.i !== 0 ? true : undefined}>
                <p class="mono tx__cap"><span>{t.num} / 09</span> {t.name}</p>
                <p class="tx__quote">{t.zone.quote}</p>
                <div class="tx__actions">
                  <a class="tx__link mono" href={`/services/${t.slug}`} data-cursor="link"><span class="ulink">View service</span> <span aria-hidden="true">→</span></a>
                  <button type="button" class="chip" data-add={t.slug} aria-pressed="false" data-cursor="link"><span class="chip__plus" aria-hidden="true"></span><span class="add-l">Add to tender</span></button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .trades { position: relative; }

  /* ---- Intro statement ---- */
  .tintro { background: var(--navy-950); color: var(--white); padding-block: var(--section-y); }
  .tintro__in { display: grid; gap: var(--space-6); }
  .tintro__h {
    --em: 7.6;
    font-size: min(var(--fs-display-2), calc((min(100vw, var(--container-max)) - 2 * var(--gutter)) / var(--em)));
  }
  @media (min-width: 640px) { .tintro__h { --em: 8.9; } }
  @media (min-width: 900px) { .tintro__h { --em: 10.2; } }
  .tintro__datum { max-width: 100%; }
  .tintro__p {
    font-family: var(--font-display); font-weight: 650; font-stretch: var(--wdth-text-display);
    font-size: var(--fs-statement); line-height: var(--lh-statement); letter-spacing: var(--tr-heading);
    max-width: min(100%, 26em);
  }
  html.js:not(.rm) .tintro__p span { opacity: 0.14; }

  /* ---- Trade index ---- */
  .tx { background: var(--concrete-100); color: var(--navy-700); padding-block: var(--section-y); }
  .tx__in { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--grid-gap); align-items: stretch; }
  .tx__list { grid-column: 1 / 7; min-width: 0; }
  .tx__rows { border-top: 1px solid var(--line-on-light); }
  .tx__row {
    display: grid; grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(1.25rem, 3svh, 2rem); border-bottom: 1px solid var(--line-on-light);
  }
  .tx__thumb { display: none; }
  .tx__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; min-width: 0; }
  .tx__tag { color: var(--concrete-600); margin: 0; }
  .tx__n { color: var(--navy-700); margin-right: 0.8em; }
  .tx__name { font-size: var(--fs-display-3); font-stretch: 100%; line-height: 0.95; margin: 0; overflow-wrap: break-word; }
  .tx__name a { color: inherit; text-decoration: none; display: block; position: relative; padding-right: 1.4em; }
  .tx__arr { position: absolute; right: 0; top: 50%; margin-top: -0.5em; line-height: 1; font-size: 0.7em; opacity: 0; transform: translateX(-0.3em); transition: opacity var(--dur-base) var(--ease-out-soft), transform var(--dur-base) var(--ease-out); }
  .tx__more { display: none; grid-template-columns: minmax(0, 1fr); }
  .tx__quote { font-size: var(--fs-body); line-height: 1.5; color: var(--concrete-800); max-width: 52ch; margin: 0; }
  .tx__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); }
  .tx__link { color: var(--navy-700); display: inline-flex; align-items: center; gap: 0.4em; min-height: 44px; }

  /* desktop active state: colour/opacity only, rows never resize */
  @media (min-width: 900px) {
    .tx__name, .tx__tag, .tx__n { transition: opacity var(--dur-base) var(--ease-out-soft), color var(--dur-base) var(--ease-out-soft); }
    html.js .tx__row:not(.is-on) .tx__name { opacity: 0.3; }
    html.js .tx__row:not(.is-on) .tx__tag { opacity: 0.55; }
    .tx__row.is-on .tx__n { color: var(--mint-700); }
    .tx__row.is-on .tx__arr, .tx__name a:focus-visible .tx__arr { opacity: 1; transform: none; }
  }

  .tx__media { grid-column: 8 / -1; position: relative; }
  .tx__sticky { position: sticky; top: calc(var(--header-h) + 2rem); display: grid; gap: var(--space-5); }
  .tx__frame { position: relative; overflow: clip; background: var(--navy-950); height: min(calc(100svh - var(--header-h) - 16rem), 40rem); }
  .tx__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s var(--ease-out-soft); }
  .tx__img.is-on { opacity: 1; }
  .tx__big {
    position: absolute; left: clamp(1rem, 2vw, 1.75rem); bottom: clamp(0.75rem, 1.6vw, 1.25rem);
    font-size: var(--fs-display-1); font-stretch: var(--wdth-condensed); line-height: 0.8; color: var(--mint-500);
    text-shadow: 0 2px 24px rgb(14 22 48 / 0.35); pointer-events: none;
  }
  .tx__infos { display: grid; grid-template-columns: minmax(0, 1fr); }
  .tx__info { grid-area: 1 / 1; display: grid; gap: var(--space-3); align-content: start; opacity: 0; transition: opacity 0.4s var(--ease-out-soft); }
  .tx__info.is-on { opacity: 1; }
  .tx__cap { color: var(--concrete-600); margin: 0; }
  .tx__cap span { color: var(--navy-700); margin-right: 0.8em; }

  /* Chip (Add to tender) */
  .chip {
    display: inline-flex; align-items: center; gap: 10px; height: 40px; padding: 0 16px 0 12px;
    border-radius: var(--radius-pill); box-shadow: inset 0 0 0 1.5px var(--navy-700);
    color: var(--navy-700); font-family: var(--font-mono); font-size: var(--fs-label); letter-spacing: var(--tr-label); text-transform: uppercase;
    transition: background var(--dur-fast) var(--ease-out-soft), color var(--dur-fast);
  }
  .chip__plus { position: relative; width: 12px; height: 12px; }
  .chip__plus::before, .chip__plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; transition: transform var(--dur-base) var(--ease-spring); }
  .chip__plus::after { transform: rotate(90deg); }
  .chip[aria-pressed='true'] { background: var(--navy-700); color: var(--mint-500); }
  .chip[aria-pressed='true'] .chip__plus::before { transform: translate(-1px, 2px) rotate(45deg) scaleX(0.5); }
  .chip[aria-pressed='true'] .chip__plus::after { transform: translate(3px, 0) rotate(-45deg); }
  .chip:hover { background: rgb(35 52 103 / 0.08); }
  .chip[aria-pressed='true']:hover { background: var(--navy-800); }

  /* Phones and small tablets: a simple list, each trade with its own photo, quote and button */
  @media (max-width: 899px) {
    .tx__list { grid-column: 1 / -1; }
    .tx__media { display: none; }
    .tx__row { grid-template-columns: 96px minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-5); align-items: start; }
    .tx__thumb { display: block; width: 96px; height: 120px; object-fit: cover; }
    .tx__name { font-size: var(--fs-h3); }
    .tx__more { display: grid; gap: var(--space-3); margin-top: 0.25rem; }
    .tx__quote { font-size: var(--fs-small); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tx__img, .tx__info, .tx__name, .tx__tag, .tx__arr { transition: none; }
  }
</style>
